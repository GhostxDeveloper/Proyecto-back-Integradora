# .env.example - Plantilla de variables de entorno requeridas
# Copia este archivo a .env y completa con tus valores reales

# ======================
# CONFIGURACIÓN SERVIDOR
# ======================
NODE_ENV=development
PORT=3000

# ======================
# FIREBASE
# ======================
# Obtén estas credenciales desde: https://console.firebase.google.com/
# Project Settings > General > Your apps > SDK setup and configuration
FIREBASE_API_KEY=tu_api_key_aqui
FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
FIREBASE_PROJECT_ID=tu-proyecto-id
FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:web:abc123def456

# ======================
# JWT (Autenticación)
# ======================
# IMPORTANTE: Genera un secreto fuerte (mínimo 32 caracteres)
# Puedes usar: openssl rand -base64 32
JWT_SECRET=tu_secreto_super_seguro_minimo_32_caracteres_cambiar_en_produccion
JWT_EXPIRES_IN=24h

# ======================
# SENDGRID (Emails)
# ======================
# Obtén tu API Key desde: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.tu_api_key_aqui
# Email verificado en SendGrid (Sender Authentication)
SENDGRID_VERIFIED_EMAIL=tu-email@verificado.com

# ======================
# LOGGING
# ======================
# Opciones: error | warn | info | debug
LOG_LEVEL=info